# FRECA 环境变量模板（复制为 .env 并填入真实值；.env 不进 git）
# 代码只从环境变量读敏感信息，禁止 hard-code。加载方式见 CODE_STANDARD §10。

# ===== LLM（必需）=====
# DeepSeek API Key（platform.deepseek.com 申请）。所有文本生成/判决调用用它。
DEEPSEEK_API_KEY=

# ===== 向量检索 API（vector_backend=dashscope 时必需）=====
# 阿里云百炼 API Key（dashscope.console.aliyun.com 申请）；
# 用于 embedding(text-embedding-v3) + rerank(qwen3-rerank)。api_key_env 见 config vector_api 段。
DASHSCOPE_API_KEY=

# 可选：覆盖默认（一般不填，走 config.yaml）
# DEEPSEEK_API_BASE=https://api.deepseek.com

# ===== 云端向量模型 local_dir（仅 AutoDL 云实例需要；本地留空走 HF id）=====
# QWEN3_EMBEDDING_PATH=/root/freca/models/Qwen3-Embedding-4B
# QWEN3_RERANKER_PATH=/root/freca/models/Qwen3-Reranker-4B

# ===== HF 权重下载（仅下载模型时用；跑推理不需要）=====
# HF_HUB_DISABLE_XET=1          # 必须：绕过 xet CAS 桥（否则 403/卡死）
# HF_ENDPOINT=https://huggingface.co   # 云端直连最稳；沙箱勿设 hf-mirror
# HF_HUB_DOWNLOAD_TIMEOUT=120   # 适中值，断流 2min 判超时并断点续传
# HF_HUB_DOWNLOAD_RETRIES=20

# ===== 网络代理（仅本地沙箱需要）=====
# HTTPS_PROXY=http://127.0.0.1:33210
